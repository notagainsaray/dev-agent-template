# Ghostty config for agentic development (installed by dev-agent-template)
# Reload: cmd+shift+,    All options: ghostty +show-config --default --docs

font-size = 14
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
window-padding-x = 8
window-padding-y = 6
window-save-state = always
macos-option-as-alt = true
copy-on-select = clipboard
scrollback-limit = 50000000

# Splits: one agent per pane
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:up
keybind = cmd+alt+down=goto_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits
